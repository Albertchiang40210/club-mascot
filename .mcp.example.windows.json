{
  "mcpServers": {
    "blender": { "command": "uvx", "args": ["mcp-for-blender"] },
    "trellis": {
      "command": "python",
      "args": ["tools/trellis_mcp.py"],
      "env": { "HF_TOKEN": "${HF_TOKEN:-}" }
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "gemini-image": {
      "command": "python",
      "args": ["tools/gemini_image_mcp.py"],
      "env": { "GEMINI_API_KEY": "${GEMINI_API_KEY:-}" }
    }
  }
}
